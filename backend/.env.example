# Plantilla de configuración. Copia este archivo como backend/.env y completa los valores.
# backend/.env está ignorado por git: NUNCA subas tus claves reales.
# Dónde encontrarlas: Supabase → Project Settings → API Keys.

# Dirección del proyecto, p. ej. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Clave pública (empieza por sb_publishable_). Puede usarse en el navegador.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (empieza por sb_secret_). SOLO para el backend. Salta las reglas RLS.
SUPABASE_SECRET_KEY=

# Opcional: segundos que dura la URL firmada de una foto (30–900). Por defecto 300.
# PHOTO_SIGNED_URL_TTL_SECONDS=300

# Opcional (en la nube, recomendado): dirección pública del sitio, sin / al final.
# La usan los buscadores (sitemap, robots.txt) y la vista previa al compartir el enlace.
# PUBLIC_SITE_URL=https://tu-dominio.com

# Opcional: Gemini para leer el texto de anuncios de redes (plan gratuito).
# Clave en https://aistudio.google.com/apikey . Vacía = la función no aparece.
# Google puede usar lo que se envía en el plan gratuito: el backend borra teléfonos,
# correos y enlaces antes de enviarlo, y nunca envía fotos.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional: motor de coincidencias con IA (etapa 7). Por defecto está ACTIVO si el modelo
# está descargado (cd backend; .\.venv\Scripts\python.exe -m app.ia.descargar). En Docker se
# descarga solo al construir la imagen.
# IA_ENABLED=true
# IA_MODEL=dinov2_s
# Similitud visual mínima para sugerir una coincidencia (0–1). 0.49 salió de la etapa 6
# (~5 % de falsas alarmas con las fotos de prueba). Provisional: recalibrar con más fotos.
# MATCH_MIN_SIMILARITY=0.49
