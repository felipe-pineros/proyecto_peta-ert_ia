# Plantilla de configuración. Copia este archivo como backend/.env y completa los valores.
# backend/.env está ignorado por git: NUNCA subas tus claves reales.
# Dónde encontrarlas: Supabase → Project Settings → API Keys.

# Dirección del proyecto, p. ej. https://abcdefghijkl.supabase.co
SUPABASE_URL=

# Clave pública (empieza por sb_publishable_). Puede usarse en el navegador.
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta (empieza por sb_secret_). SOLO para el backend. Salta las reglas RLS.
SUPABASE_SECRET_KEY=

# Opcional: segundos que dura la URL firmada de una foto (30–900). Por defecto 300.
# PHOTO_SIGNED_URL_TTL_SECONDS=300

# Opcional (en la nube, recomendado): dirección pública del sitio, sin / al final.
# La usan los buscadores (sitemap, robots.txt) y la vista previa al compartir el enlace.
# PUBLIC_SITE_URL=https://tu-dominio.com
